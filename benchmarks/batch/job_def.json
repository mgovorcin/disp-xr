{
  "jobDefinitionName": "disp-xr-bench",
  "type": "container",
  "platformCapabilities": ["EC2"],
  "timeout": {"attemptDurationSeconds": 14400},
  "retryStrategy": {"attempts": 1},
  "containerProperties": {
    "image": "<ACCOUNT_ID>.dkr.ecr.<REGION>.amazonaws.com/disp-xr-bench:<TAG>",
    "jobRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/<JOB_ROLE>",
    "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/<EXECUTION_ROLE>",
    "resourceRequirements": [{"type": "VCPU", "value": "32"}, {"type": "MEMORY", "value": "240000"}]
  },
  "tags": {"Project": "disp-xr", "Component": "bench", "Owner": "<OWNER>"},
  "propagateTags": true
}
